<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="back_fixed_box">
    <static>true</static>
    <link name="box_link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.3 0.4 1.5</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.8 0.2 0.2 1.0</diffuse>   <!-- Red -->
          <specular>0.4 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.3 0.4 1.5</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
        <!-- Drake uses these; Gazebo <surface> will be ignored -->
<!-- SOFT (compliant) hydroelastic for the back fixed box -->
    <drake:proximity_properties>
      <drake:compliant_hydroelastic/>
      <drake:hydroelastic_modulus>2.0e7</drake:hydroelastic_modulus>
      <drake:hunt_crossley_dissipation>15.0</drake:hunt_crossley_dissipation>
      <drake:mu_static>0.60</drake:mu_static>
      <drake:mu_dynamic>0.55</drake:mu_dynamic>
      <!-- Optional: resolution for soft volume mesh (smaller → finer) -->
      <!-- <drake:resolution_hint>0.03</drake:resolution_hint> -->
    </drake:proximity_properties>
      </collision>
      <!-- Positioned behind the middle fixed box in X-axis direction -->
      <pose>1.0 0.0 0.75 0 0 0</pose>
    </link>
  </model>
</sdf>
