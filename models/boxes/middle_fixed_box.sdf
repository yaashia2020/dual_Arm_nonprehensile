<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="middle_fixed_box">
    <static>true</static>
    <link name="box_link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.25 0.7</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.2 0.2 0.8 0.5</diffuse>   <!-- Blue -->
          <specular>0.1 0.1 0.4 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 0.25 0.7</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <!-- Positioned between ground and movable box -->
      <pose>0.7 0.0 0.35 0 0 0</pose>
    </link>
  </model>
</sdf>
