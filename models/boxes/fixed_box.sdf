<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="fixed_box">
    <static>true</static>

    <link name="table">
      <!-- Tabletop -->
      <visual name="tabletop_visual">
        <geometry>
          <box>
            <size>0.4 0.4 0.02</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.6 0.4 0.3 1.0</diffuse>
        </material>
        <pose>0 0 0.3 0 0 0</pose>
      </visual>
      <collision name="tabletop_collision">
        <geometry>
          <box>
            <size>0.4 0.4 0.02</size>
          </box>
        </geometry>
        <pose>0 0 0.3 0 0 0</pose>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static>0.9</drake:mu_static>
          <drake:mu_dynamic>0.7</drake:mu_dynamic>
          <drake:hunt_crossley_dissipation>50.0</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>

      <!-- Legs -->
      <visual name="leg1_visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.2 0.1 1.0</diffuse>
        </material>
        <pose> 0.19  0.19 0.15 0 0 0</pose>
      </visual>
      <collision name="leg1_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <pose> 0.19  0.19 0.15 0 0 0</pose>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static>0.8</drake:mu_static>
          <drake:mu_dynamic>0.6</drake:mu_dynamic>
          <drake:hunt_crossley_dissipation>50.0</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>

      <visual name="leg2_visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.2 0.1 1.0</diffuse>
        </material>
        <pose> 0.19 -0.19 0.15 0 0 0</pose>
      </visual>
      <collision name="leg2_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <pose> 0.19 -0.19 0.15 0 0 0</pose>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static>0.8</drake:mu_static>
          <drake:mu_dynamic>0.6</drake:mu_dynamic>
          <drake:hunt_crossley_dissipation>50.0</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>

      <visual name="leg3_visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.2 0.1 1.0</diffuse>
        </material>
        <pose>-0.19  0.19 0.15 0 0 0</pose>
      </visual>
      <collision name="leg3_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <pose>-0.19  0.19 0.15 0 0 0</pose>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static>0.8</drake:mu_static>
          <drake:mu_dynamic>0.6</drake:mu_dynamic>
          <drake:hunt_crossley_dissipation>50.0</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>

      <visual name="leg4_visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.2 0.1 1.0</diffuse>
        </material>
        <pose>-0.19 -0.19 0.15 0 0 0</pose>
      </visual>
      <collision name="leg4_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.3</size>
          </box>
        </geometry>
        <pose>-0.19 -0.19 0.15 0 0 0</pose>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static>0.8</drake:mu_static>
          <drake:mu_dynamic>0.6</drake:mu_dynamic>
          <drake:hunt_crossley_dissipation>50.0</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>

    <!-- Just move this pose to move the whole table -->
    <pose>0 -0.3 0 0 0 0</pose>
  </model>
</sdf>

