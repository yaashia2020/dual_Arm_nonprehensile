<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="movable_box">
    <static>false</static>
    <link name="box_link">
      <inertial>
        <mass>0.5</mass>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.22 0.3 0.2</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.15 0.05 1.0</diffuse>   <!-- Dark brown -->
          <specular>0.2 0.1 0.05 1.0</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.22 0.3 0.2</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
        </surface>

        <!-- Enable rigid hydroelastic contact -->
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static>0.9</drake:mu_static>
          <drake:mu_dynamic>0.8</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>

      <!-- Positioned on top of fixed box -->
      <pose>0.0 -0.3 0.41 0 0 0</pose>
    </link>
  </model>
</sdf>

