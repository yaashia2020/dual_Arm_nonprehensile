<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="movable_box">
    <static>false</static>
    <link name="box_link">
      <inertial>
        <mass>2</mass>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.22 0.3 0.35</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.15 0.05 1.0</diffuse>   <!-- Dark brown -->
          <specular>0.2 0.1 0.05 1.0</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.22 0.3 0.35</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100</kp>
              <kd>100</kd>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
        </surface>

        <!-- Enable soft hydroelastic contact (can be modified)-->
        <drake:proximity_properties>
          <!-- <drake:compliant_hydroelastic /> -->
          <!-- <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus> -->
          <!-- <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus> -->
          <!-- <drake:hunt_crossley_dissipation>1.0</drake:hunt_crossley_dissipation> -->
          <!-- <drake:mu_static>0.6</drake:mu_static> -->
          <!-- <drake:mu_dynamic>0.55</drake:mu_dynamic> -->
          <drake:rigid_hydroelastic/>
  <!-- Rigid doesn’t use hydroelastic_modulus; remove it if present -->
          <drake:hunt_crossley_dissipation>1.0</drake:hunt_crossley_dissipation>
          <drake:mu_static>0.60</drake:mu_static>
          <drake:mu_dynamic>0.55</drake:mu_dynamic>
          <!-- <drake:resolution_hint>0.03</drake:resolution_hint> -->
        </drake:proximity_properties>
      </collision>

      <!-- Positioned on top of fixed box -->
      <pose>0.7 0 0.875 0 0 0.02</pose>
    </link>
  </model>
</sdf>

